# Copy to /etc/rdwc-daily-report.env on Pi
# chmod 600 /etc/rdwc-daily-report.env

RDWC_API_URL=http://127.0.0.1:8080
REPORT_OUTPUT=/home/pi/reports/grow-report.html

EMAIL_SERVER=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
# Gmail app password (spaces optional; script strips them)
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_TO=your-destination@gmail.com
EMAIL_FROM=RDWC System <your-email@gmail.com>
