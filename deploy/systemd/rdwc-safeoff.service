[Unit]
Description=RDWC Safe-OFF oneshot (force all relays OFF at boot)
Before=rdwc.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/pi/RDWC-v4
ExecStart=/home/pi/RDWC-v4/venv/bin/python -m app.safeoff
TimeoutStartSec=30s
RemainAfterExit=no

[Install]
WantedBy=multi-user.target