ENV=prod
I2C_BUS=1
PH_ADDR=0x63
EC_ADDR=0x64
RTD_ADDR=0x66

PH_SETPOINT=5.9
PH_DEADBAND=0.1
PH_UP_MAX_SEC=2
PH_UP_COOLDOWN_SEC=90

RELAY_PH_UP=5
RELAY_GROW=6
RELAY_MICRO=13
RELAY_BLOOM=19
RELAY_MAIN_PUMP=26
RELAY_CHILLER_PUMP=16
RELAY_CHILLER=20
RELAY_LIGHTS=21

MAIN_PUMP_ON=1
CHILLER_PUMP_ON=1
HOST=0.0.0.0
PORT=8080

# NEW
SAMPLE_INTERVAL_SEC=10
FORCE_MOCK_SENSORS=0

# LIGHT SCHEDULE (24h times)
LIGHTS_ON_HOUR=6
LIGHTS_OFF_HOUR=22

# UI REFRESH
UI_REFRESH_SEC=10

# --- NUTRIENTS / DOSING ---
TOTAL_VOLUME_L=100            # your system total water volume (L)
ML_PER_SEC_GROW=10            # pump calibration (ml/sec) - update after calibration
ML_PER_SEC_MICRO=10
ML_PER_SEC_BLOOM=10
DOSE_MAX_SEC_PER_RUN=5        # safety: max continuous seconds per pump run
DOSE_COOLDOWN_SEC=15          # safety: wait between components
ALLOW_DOSING_WHEN_MOCK=0      # 0=block dosing in mock-sensor mode (recommended)