[Unit]
Description=RDWC Morning Report
After=rdwc.service

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/RDWC-v4
Environment=PATH=/home/pi/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/pi/venv/bin/python3 /home/pi/RDWC-v4/scripts/morning_report.py --send-alerts
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target