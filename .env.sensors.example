# RDWC Sensors Performance Tuning
# Copy to .env or add to systemd Environment= to override defaults
# All values are optional - code uses fast defaults if not set

# Backend deadline: maximum time for a complete sensor read cycle
RDWC_SENSORS_READ_DEADLINE_S=2.5

# API layer timeout: hard limit enforced at FastAPI level
RDWC_SENSORS_API_TIMEOUT_S=2.8

# I²C polling timeout per device (RTD/EC/pH)
RDWC_I2C_POLL_TIMEOUT_S=1.0

# Retry delay when device returns empty payload
RDWC_I2C_RETRY_DELAY_S=0.15

# Retry delay for transient I/O errors
RDWC_I2C_IO_RETRY_DELAY_S=0.05

# Temperature compensation settle time (per Atlas EZO spec: 900ms)
RDWC_I2C_COMP_SETTLE_S=0.90
