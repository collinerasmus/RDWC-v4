# RDWC-v4 Environment Configuration Template
# Copy to .env and modify values as needed

# === ALERT SYSTEM CONFIGURATION ===

# Enable/disable alert channels (true/false)
ALERT_ENABLE_TELEGRAM=false
ALERT_ENABLE_EMAIL=false

# Telegram Bot Configuration (if enabled)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Email SMTP Configuration (if enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
ALERT_RECIPIENTS=admin@example.com,user@example.com

# === SENSOR THRESHOLDS ===

# pH monitoring (typical hydroponic range)
PH_LOW_THRESHOLD=5.5
PH_HIGH_THRESHOLD=6.3
PH_HYSTERESIS=0.1

# EC monitoring (mS/cm, adjust for your nutrients)
EC_LOW_THRESHOLD=1.2
EC_HIGH_THRESHOLD=2.0
EC_HYSTERESIS=0.1

# Temperature monitoring (°C)
TEMP_LOW_THRESHOLD=18.0
TEMP_HIGH_THRESHOLD=22.0
TEMP_HYSTERESIS=0.5

# === ALERT TIMING ===

# Minimum time between alerts of same type (minutes)
ALERT_DEBOUNCE_MINUTES=60

# Grace period before clearing recovered alerts (minutes)
ALERT_RECOVERY_GRACE_MINUTES=15

# === GPIO PIN CONFIGURATION ===
# (Uncomment and modify if different from defaults)

#PIN_PH_UP=5
#PIN_GROW_PUMP=6
#PIN_MICRO_PUMP=13
#PIN_BLOOM_PUMP=19
#PIN_MAIN_PUMP=26
#PIN_CHILLER_PUMP=16
#PIN_WATER_CHILLER=20
#PIN_GROW_LIGHTS=21

# Relay polarity (1 for active-low boards, 0 for active-high)
RELAY_ACTIVE_LOW=1

# === SYSTEM SETTINGS ===

# Require camera for readiness check (true/false)
READINESS_REQUIRE_CAMERA=false

# Database path (uncomment to override default)
#RDWC_DB=/path/to/custom/database.db